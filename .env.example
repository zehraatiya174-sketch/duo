# ---------------------------------------------------------------------------
# Duo Chat — environment
# Copy to `.env` and fill in. Never commit `.env`.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
# Local:  postgresql://postgres:postgres@localhost:5432/duochat?schema=public
# Neon:   postgresql://user:pass@ep-xxx.region.aws.neon.tech/duochat?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/duochat?schema=public

# --- Auth -----------------------------------------------------------------
BETTER_AUTH_SECRET=replace-me-with-64-hex-chars-of-random-data-at-least-32-long
BETTER_AUTH_URL=http://localhost:3000

# Optional. Leave blank to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The only two accounts that may ever exist ----------------------------
AUTHORIZED_USER_1=you@example.com
AUTHORIZED_USER_2=them@example.com
# Which of the two sees the admin dashboard. Defaults to AUTHORIZED_USER_1.
ADMIN_EMAIL=you@example.com

# --- Additional verification ----------------------------------------------
# A second gate after sign-in: knowing the account password is not enough, the
# holder must also enter this phrase.
#
# Required. There is no built-in default — the app refuses to start with
# VERIFICATION_ENABLED=true and this unset, rather than falling back to a phrase
# that would be readable by anyone with the source.
VERIFICATION_PASSPHRASE=change-me
# Set to false to switch the gate off entirely.
VERIFICATION_ENABLED=true
# How long one successful verification lasts before it is asked for again.
VERIFICATION_TTL_HOURS=12

# --- Storage --------------------------------------------------------------
# local | cloudinary | s3 | supabase | b2
# Switching providers is a restart, not a code change. Existing attachments keep
# the provider they were written with, so migrate blobs before changing this on
# an installation that already holds media.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.storage

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Any S3 API: AWS, Cloudflare R2, MinIO. Set S3_ENDPOINT for non-AWS.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Supabase Storage. The service-role key bypasses row-level security — server
# side only, never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=duo-media

# Backblaze B2 via its S3-compatible endpoint. B2_ENDPOINT defaults to
# https://s3.<B2_REGION>.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=

# 64 hex characters (32 bytes). Enables AES-256-GCM encryption of media at rest.
MEDIA_ENCRYPTION_KEY=
# Signs short-lived media URLs. Must be >= 32 chars.
MEDIA_URL_SECRET=replace-me-with-another-64-hex-chars-of-random-data
MEDIA_URL_TTL_SECONDS=300
# 512 MB. Uploads are buffered in memory, so raise this alongside instance RAM.
MAX_UPLOAD_BYTES=536870912
# Soft ceiling shown as headroom in the admin storage view. 250 GB.
STORAGE_QUOTA_BYTES=268435456000

# --- Email (password reset). Omit to log reset links to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Duo <no-reply@example.com>"

# --- Realtime -------------------------------------------------------------
SOCKET_PATH=/api/socket
SOCKET_CORS_ORIGINS=http://localhost:3000

# --- WebRTC ---------------------------------------------------------------
# STUN alone works on most home networks but cannot traverse symmetric NAT, so
# a relay is REQUIRED in production — the app refuses to boot without one.
#
# Comma-separated; list every endpoint your provider gives you. They are
# re-ordered server-side so TURN over TLS on 443 is allocated first (it is
# indistinguishable from HTTPS, so it survives captive portals and corporate
# proxies), then other TLS, then TCP, then UDP. Endpoints from more than one
# provider may be listed together: the browser allocates against all of them
# and the one that answers wins, so a dead relay costs a candidate, not a call.
#
#   TURN_URLS=turns:relay.example.net:443?transport=tcp,turn:relay.example.net:3478
TURN_URLS=

# Authenticate with EITHER the long-lived pair your provider issued...
TURN_USERNAME=
TURN_CREDENTIAL=
# ...OR coturn's REST scheme, which mints a short-lived credential per session.
# Preferred where available: it expires on its own, so a credential lifted out
# of devtools stops working instead of staying valid until someone notices.
# Must match the `static-auth-secret` in your coturn config.
TURN_STATIC_AUTH_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
# Pins every call to the relay. Costs latency and bandwidth; only useful when
# the participants' IP addresses must never be exposed to each other.
TURN_FORCE_RELAY=false

# --- GIFs -----------------------------------------------------------------
# Free key from https://developers.google.com/tenor. Leave blank to hide the
# GIF picker. Searches are proxied through the server, so neither the key nor
# either user's IP address is ever exposed to Tenor.
TENOR_API_KEY=

# --- Behaviour ------------------------------------------------------------
DESTROY_EPHEMERAL_METADATA=true
RATE_LIMIT_ENABLED=true

# --- Public (inlined into the client bundle — no secrets here) ------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Duo
# Leave blank when the socket server is same-origin (the default single-process
# deployment). Set to e.g. https://duo-socket.up.railway.app when the realtime
# server is deployed separately from the Next.js app.
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SOCKET_PATH=/api/socket
NEXT_PUBLIC_MAX_UPLOAD_BYTES=104857600
