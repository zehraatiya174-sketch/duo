# The build stage runs `COPY . .`, so anything not excluded here is baked into
# the image. Keep secrets and local-only state out.

.env
.env.local
.env.*.local

node_modules
.next
out
dist
build

.git
.gitignore

# Uploaded media when STORAGE_PROVIDER=local. Never ship one machine's uploads.
.storage

coverage
test-results
playwright-report
playwright/.cache

*.log
npm-debug.log*

.vscode
.idea
.DS_Store
Thumbs.db

README.md
docs
